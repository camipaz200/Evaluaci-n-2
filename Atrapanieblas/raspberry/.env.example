# Copiar a .env y completar (chmod 600 .env)
DB_HOST=TU-INSTANCIA.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_USER=atrapa_app
DB_PASS=CAMBIAR_ESTA_CLAVE
DB_NAME=atrapanieblas
# CA de RDS (opcional pero recomendado): https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_CA=/home/pi/atrapanieblas/global-bundle.pem

# Mosquitto local de la Raspberry (listener 127.0.0.1:1883)
MQTT_LOCAL_HOST=127.0.0.1
# Credenciales del broker que la API entrega a la app tras el login
MQTT_APP_USER=app_iot
MQTT_APP_PASS=CAMBIAR_CLAVE_MQTT

# Certificado HTTPS de la API (los crea gen_certs.sh)
TLS_CERT=/home/pi/atrapanieblas/certs/server.crt
TLS_KEY=/home/pi/atrapanieblas/certs/server.key
